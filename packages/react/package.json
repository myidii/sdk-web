{
  "name": "@myidii/react",
  "version": "0.1.0",
  "description": "MYIDII for React: a hook and a button that run the liveness scan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@myidii/web": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "keywords": [
    "myidii",
    "liveness",
    "face",
    "verification",
    "kyc",
    "react",
    "hook"
  ],
  "homepage": "https://github.com/myidii/sdk-web/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myidii/sdk-web.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/myidii/sdk-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
