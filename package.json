{
  "name": "myidii-sdk-web",
  "private": true,
  "description": "MYIDII browser SDKs: @myidii/web and @myidii/react",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @myidii/web && npm run build -w @myidii/react",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:packaging": "node packaging/run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
